      "name": "knowns-core",
      "type": "registry:lib",
      "title": "Knowns UI core",
      "description": "cn() helper, Actor/Span/Task/Approval types, the event-fed run store (createAgentRun, useAgentRun) and shared state labels and colours.",
      "files": [
        {
          "path": "registry/knowns/lib/knowns/utils.ts",
          "type": "registry:lib",
          "target": "lib/knowns/utils.ts"
        },
        {
          "path": "registry/knowns/lib/knowns/types.ts",
          "type": "registry:lib",
          "target": "lib/knowns/types.ts"
        },
        {
