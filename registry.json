        {
          "path": "registry/knowns/lib/knowns/status.ts",
          "type": "registry:lib",
          "target": "lib/knowns/status.ts"
        },
        {
          "path": "registry/knowns/lib/knowns/json.tsx",
          "type": "registry:lib",
          "target": "lib/knowns/json.tsx"
        }
      ],
      "css": {
        "@keyframes kn-breathe": {
          "0%, 100%": {
            "box-shadow": "0 0 0 0 transparent"
          },
          "50%": {
            "box-shadow": "0 0 0 6px color-mix(in srgb, var(--hue, currentColor) 16%, transparent)"
          }
        },
        "@keyframes kn-rise": {
          "from": {
            "transform": "translateY(6px)"
          }
        },
        "@keyframes kn-shimmer": {
          "to": {
            "transform": "translateX(300%)"
          }
        },
        "@keyframes kn-word": {
          "from": {
            "opacity": "0",
            "filter": "blur(3px)"
          }
        },
        "@keyframes kn-pop": {
          "from": {
            "opacity": "0",
            "transform": "scale(0.6)"
          }
        }
      }
    },
